# PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB

# Optional: allowed browser origins
ALLOWED_ORIGINS=

# true (default): if the RU cache is empty, import stations in the background after start.
# false: skip the first import (the 24h scheduler still runs).
STATIONS_SYNC_BEFORE_LISTEN=true

# Optional exact station-level price provider.
# If these are empty, the public Internet feed in scripts/sync-prices.js is used.
PRICE_API_URL=
PRICE_API_KEY=
